# Names-only local environment template. Values are intentionally blank.
# Copy to .env, set values from your secret manager, and never commit .env.
# See docs/migration-environment-template.md for variable descriptions.

# Runtime and database
NODE_ENV=
APP_URL=
DATABASE_URL=
SESSION_SECRET=
JWT_SECRET=
JWT_REFRESH_SECRET=

# Firebase and OAuth
